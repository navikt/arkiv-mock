<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>no.nav.soknad.archiving</groupId>
	<artifactId>arkiv-mock</artifactId>
	<version>1.1.2</version>
	<packaging>pom</packaging>
	<name>arkiv-mock</name>
	<description>Mock replacement of the Joark Archive, used for end-to-end and load tests.</description>

	<modules>
		<module>api</module>
		<module>mock</module>
	</modules>

	<properties>
		<token-support.version>6.0.14</token-support.version>

		<logstash.version>9.0</logstash.version>
		<kafka.version>4.4.0</kafka.version>
		<jackson-databind-nullable.version>0.2.12</jackson-databind-nullable.version>
		<coroutines.version>1.11.0</coroutines.version>
		<springmockk.version>5.0.1</springmockk.version>
		<mockk.version>1.14.11</mockk.version>
		<graphql-kotlin.version>11.0.0</graphql-kotlin.version>
		<pdfbox.version>3.0.8</pdfbox.version>
		<!--OpenAPI-->
		<springdoc-openapi.version>3.1.1</springdoc-openapi.version>
		<swagger-annotations.version>2.2.55</swagger-annotations.version>
		<openapi-generator-maven-plugin.version>7.26.0</openapi-generator-maven-plugin.version>

		<okhttp3.version>5.5.1</okhttp3.version>

		<maven-enforcer.version>3.6.3</maven-enforcer.version>

		<java.version>21</java.version>
		<kotlin.version>2.4.21</kotlin.version>
		<kotlin-serialization.version>1.12.0</kotlin-serialization.version>
		<maven.version>3.8.8</maven.version>
	</properties>

	<repositories>
		<repository>
			<id>github</id>
			<name>GitHub felles Maven Packagesfor Navikt</name>
			<url>https://github-package-registry-mirror.gc.nav.no/cached/maven-release</url>
		</repository>
		<repository>
			<id>confluent</id>
			<url>https://packages.confluent.io/maven</url>
		</repository>
		<repository>
			<id>central</id>
			<url>https://repo1.maven.org/maven2</url>
		</repository>
	</repositories>
</project>
